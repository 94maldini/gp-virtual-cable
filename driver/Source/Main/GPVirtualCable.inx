;======================================================
; GPVirtualCable_SA install
;======================================================
[GPVirtualCable_SA.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration, WDMAUDIO.Registration
CopyFiles=GPVirtualCable_SA.CopyList
AddReg=GPVirtualCable_SA.AddReg

[GPVirtualCable_SA.NT.Interfaces]
;
; Interfaces per endpoint (generated). Wave filter: KSCATEGORY_AUDIO + RENDER/CAPTURE + REALTIME;
; topology filter: KSCATEGORY_AUDIO + KSCATEGORY_TOPOLOGY.
;
; Mono1 render
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveRenderMono1%, GP.I.WaveRenderMono1
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_WaveRenderMono1%, GP.I.WaveRenderMono1
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveRenderMono1%, GP.I.WaveRenderMono1
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopoRenderMono1%, GP.I.TopoRenderMono1
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopoRenderMono1%, GP.I.TopoRenderMono1

; Mono2 render
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveRenderMono2%, GP.I.WaveRenderMono2
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_WaveRenderMono2%, GP.I.WaveRenderMono2
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveRenderMono2%, GP.I.WaveRenderMono2
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopoRenderMono2%, GP.I.TopoRenderMono2
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopoRenderMono2%, GP.I.TopoRenderMono2

; Mono3 render
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveRenderMono3%, GP.I.WaveRenderMono3
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_WaveRenderMono3%, GP.I.WaveRenderMono3
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveRenderMono3%, GP.I.WaveRenderMono3
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopoRenderMono3%, GP.I.TopoRenderMono3
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopoRenderMono3%, GP.I.TopoRenderMono3

; Mono4 render
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveRenderMono4%, GP.I.WaveRenderMono4
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_WaveRenderMono4%, GP.I.WaveRenderMono4
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveRenderMono4%, GP.I.WaveRenderMono4
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopoRenderMono4%, GP.I.TopoRenderMono4
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopoRenderMono4%, GP.I.TopoRenderMono4

; Mono5 render
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveRenderMono5%, GP.I.WaveRenderMono5
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_WaveRenderMono5%, GP.I.WaveRenderMono5
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveRenderMono5%, GP.I.WaveRenderMono5
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopoRenderMono5%, GP.I.TopoRenderMono5
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopoRenderMono5%, GP.I.TopoRenderMono5

; Mono6 render
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveRenderMono6%, GP.I.WaveRenderMono6
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_WaveRenderMono6%, GP.I.WaveRenderMono6
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveRenderMono6%, GP.I.WaveRenderMono6
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopoRenderMono6%, GP.I.TopoRenderMono6
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopoRenderMono6%, GP.I.TopoRenderMono6

; Mono7 render
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveRenderMono7%, GP.I.WaveRenderMono7
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_WaveRenderMono7%, GP.I.WaveRenderMono7
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveRenderMono7%, GP.I.WaveRenderMono7
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopoRenderMono7%, GP.I.TopoRenderMono7
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopoRenderMono7%, GP.I.TopoRenderMono7

; Mono8 render
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveRenderMono8%, GP.I.WaveRenderMono8
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_WaveRenderMono8%, GP.I.WaveRenderMono8
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveRenderMono8%, GP.I.WaveRenderMono8
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopoRenderMono8%, GP.I.TopoRenderMono8
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopoRenderMono8%, GP.I.TopoRenderMono8

; Stereo1 render
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveRenderStereo1%, GP.I.WaveRenderStereo1
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_WaveRenderStereo1%, GP.I.WaveRenderStereo1
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveRenderStereo1%, GP.I.WaveRenderStereo1
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopoRenderStereo1%, GP.I.TopoRenderStereo1
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopoRenderStereo1%, GP.I.TopoRenderStereo1

; Stereo2 render
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveRenderStereo2%, GP.I.WaveRenderStereo2
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_WaveRenderStereo2%, GP.I.WaveRenderStereo2
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveRenderStereo2%, GP.I.WaveRenderStereo2
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopoRenderStereo2%, GP.I.TopoRenderStereo2
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopoRenderStereo2%, GP.I.TopoRenderStereo2

; Stereo3 render
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveRenderStereo3%, GP.I.WaveRenderStereo3
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_WaveRenderStereo3%, GP.I.WaveRenderStereo3
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveRenderStereo3%, GP.I.WaveRenderStereo3
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopoRenderStereo3%, GP.I.TopoRenderStereo3
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopoRenderStereo3%, GP.I.TopoRenderStereo3

; Stereo4 render
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveRenderStereo4%, GP.I.WaveRenderStereo4
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_WaveRenderStereo4%, GP.I.WaveRenderStereo4
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveRenderStereo4%, GP.I.WaveRenderStereo4
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopoRenderStereo4%, GP.I.TopoRenderStereo4
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopoRenderStereo4%, GP.I.TopoRenderStereo4

; capture
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveCapture%, GP.I.WaveCapture
AddInterface=%KSCATEGORY_CAPTURE%, %KSNAME_WaveCapture%, GP.I.WaveCapture
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveCapture%, GP.I.WaveCapture
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopoCapture%, GP.I.TopoCapture
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopoCapture%, GP.I.TopoCapture


[GPVirtualCable_SA.NT.Services]
AddService=GPVirtualCable,0x00000002,GPVirtualCable_Service_Inst

[GPVirtualCable_Service_Inst]
DisplayName=%GPVirtualCable.SvcDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\GPVirtualCable.sys

[GPVirtualCable_SA.NT.HW]
AddReg = AUDIOHW.AddReg

[AUDIOHW.AddReg]
; FILE_DEVICE_SOUND
HKR,,DeviceType,0x10001,0x0000001D
; SDDL_DEVOBJ_SYS_ALL_ADM_RWX_WORLD_RWX_RES_RWX
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

;======================================================
; WDF
;======================================================
[GPVirtualCable_SA.NT.Wdf]
KmdfService = GPVirtualCable, GPVirtualCable_SA_WdfSect

[GPVirtualCable_SA_WdfSect]
KmdfLibraryVersion = $KMDFVERSION$

