;
; GPVirtualCable.inx -- template untuk python -m gpcable.codegen (sumber: cables.toml).
; Dibangun dari SimpleAudioSample.inx (Microsoft audio/simpleaudiosample, MS-PL).
; Placeholder (INTERFACE_SECTIONS, ADD_INTERFACES, STRINGS) diganti generator;
; file hasil: driver\Source\Main\GPVirtualCable.inx (di-commit, jangan diedit manual).
;
[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
Provider    = %ProviderName%
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
DriverVer   = 02/22/2016, 1.0.0.1
CatalogFile = GPVirtualCable.cat
PnpLockDown = 1

[SourceDisksNames]
222=%DiskName%,"",222

[SourceDisksFiles]
GPVirtualCable.sys=222

[SignatureAttributes]
GPVirtualCable.sys=SignatureAttributes.DRM

[SignatureAttributes.DRM]
DRMLevel=1300

[SignatureAttributes.PETrust]
PETrust=true

[Manufacturer]
%MfgName%=GPVIRTUALCABLE,NT$ARCH$.10.0...19041

[GPVIRTUALCABLE.NT$ARCH$.10.0...19041]
%GPVirtualCable_SA.DeviceDesc%=GPVirtualCable_SA, Root\GPVirtualCable

[DestinationDirs]
GPVirtualCable_SA.CopyList=13 ; 13=Package's DriverStore directory

;======================================================
; GPVirtualCable_SA
;======================================================
[GPVirtualCable_SA.CopyList]
GPVirtualCable.sys

[GPVirtualCable_SA.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,GPVirtualCable.sys

;
; Power management settings (from the sample).
;
HKR,PowerSettings,SingleComponentMultiFxStates,3,1,0,0,0  ; Turn on multi Fx support.
HKR,PowerSettings,ConservationIdleTime,3,3,0,0,0          ; 3 seconds for idle power management when on battery
HKR,PowerSettings,PerformanceIdleTime,3,3,0,0,0           ; 3 seconds for idle power management when on AC power
HKR,PowerSettings,IdlePowerState,3,3,0,0,0                ; go to D3 for idle power management

HKR,Drivers,SubClasses,,"wave,midi,mixer"

HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv

HKR,Drivers\wave\wdmaud.drv,Description,,%GPVirtualCable_SA.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%GPVirtualCable_SA.DeviceDesc%

;======================================================
; Per-endpoint interface sections (generated: 12 render + 1 capture)
;======================================================
[GP.I.WaveRenderMono1]
AddReg=GP.I.WaveRenderMono1.AddReg

[GP.I.WaveRenderMono1.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%GP_Mono1_Name%

[GP.I.TopoRenderMono1]
AddReg=GP.I.TopoRenderMono1.AddReg

[GP.I.TopoRenderMono1.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%GP_Mono1_Name%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

